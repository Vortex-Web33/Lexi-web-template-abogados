---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Icon } from 'astro-icon/components';
import type { Translation } from '../i18n';
interface Props {
  t: Translation;
}

const { t } = Astro.props;
const contact = getRelativeLocaleUrl(t.lang, 'contact');
---

<section
  class="relative flex h-svh flex-col overflow-hidden px-6 pt-10 md:px-14 md:pt-12 lg:px-20"
  data-hero
>
  <h1
    class="mx-auto max-w-[13em] text-balance text-center text-[clamp(1.6rem,5.5vw,4.75rem)] font-bold uppercase leading-[1.03] tracking-[-0.02em] text-ink"
    data-hero-title
  >
    {t.hero.titleLine1}
    <br />
    {t.hero.titleLine2}
  </h1>

  <div
    class="mx-auto mt-5 flex w-full max-w-2xl flex-col items-center gap-5 sm:flex-row sm:justify-center sm:gap-8"
    data-hero-meta
  >
    <p
      class="max-w-sm text-center text-sm leading-relaxed text-taupe sm:text-left md:text-[15px]"
      data-hero-sub
    >
      {t.hero.subtitle}
    </p>
    <a
      href={contact}
      class="inline-flex shrink-0 items-center gap-2 rounded-full bg-mocha px-6 py-3.5 text-xs font-medium uppercase text-luxe-sm text-ivory transition-all hover:scale-[1.03] hover:bg-cocoa"
      data-hero-cta
    >
      {t.hero.cta}
      <Icon name="lucide:arrow-up-right" class="h-3 w-3" />
    </a>
  </div>

  <div class="relative mt-5 min-h-0 flex-1" data-hero-visual>
    <div
      class="absolute left-1/2 top-1/2 h-[84%] w-[min(74vw,560px)] -translate-x-1/2 -translate-y-1/2"
      aria-hidden="true"
      data-hero-frame
    >
    </div>

    <div
      class="absolute left-0 top-1/2 hidden -translate-y-1/2 max-w-52.5 pl-5 text-left lg:block"
      data-hero-authority
    >
      <p class="text-[12px] font-bold uppercase tracking-luxe text-stone">
        {t.hero.authority.title}
      </p>
      <p class="mt-2.5 text-[12px] leading-relaxed text-taupe">
        {t.hero.authority.text}
      </p>
    </div>

    <img
      src="/images/lady-justice.webp"
      alt={t.hero.imageAlt}
      class="absolute bottom-[4svh] left-1/2 z-10 h-[95%] max-w-[72%] -translate-x-1/2 object-contain filter[drop-shadow(0_28px_36px_rgba(43,32,23,0.22))] mask-image[linear-gradient(to_bottom,black_90%,transparent_100%)]"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    <div
      class="absolute right-0 top-1/2 hidden -translate-y-1/2 lg:block lg:max-w-[80%]"
      data-hero-certificates
    >
      <div class="flex items-stretch justify-end gap-4">
        {
          t.hero.certificates.map((c) => (
            <figure class="flex w-47.5 flex-col items-center gap-2.5  px-4 py-5 text-center shadow-[0_8px_20px_-8px_rgba(43,32,23,0.25)]">
              <Icon name="lucide:badge-check" class="h-8 w-8 text-bronze" />
              <figcaption>
                <p class="text-[12px] font-semibold leading-snug text-ink">{c.name}</p>
                <p class="mt-1 text-[12px] uppercase tracking-luxe text-stone">{c.detail}</p>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>
