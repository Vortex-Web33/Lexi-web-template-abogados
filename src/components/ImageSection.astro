---
import type { Translation } from '../i18n';

interface Props {
  t: Translation;
}

const { t } = Astro.props;

const ringText = t.imageSection.caption.split(' ').join(' · ');
---

<section class="relative" data-image-section>
  <div
    class="relative h-[50svh] w-full overflow-hidden sm:h-[60svh] md:h-[72svh]"
    data-parallax
  >
    <img
      src="/images/office.jpg"
      alt={t.imageSection.caption}
      width="2000"
      height="1335"
      class="h-full w-full object-cover object-[center_35%] brightness-[0.92] contrast-[1.05] saturate-[0.85] sepia-[0.18] will-change-transform"
      loading="lazy"
      decoding="async"
      data-parallax-target
    />

    <div class="absolute bottom-5 left-4 md:bottom-9 md:left-10" data-caption>
      <div class="flex max-w-[34ch] items-start gap-3 md:max-w-[44ch]">
        <span aria-hidden="true" class="mt-1.5 h-px w-9 shrink-0 bg-ivory/70 md:w-12"></span>
        <p class="text-[13px] font-light leading-relaxed tracking-wide text-ivory/90 md:text-[15px]">
          {t.imageSection.caption}
        </p>
      </div>
    </div>
  </div>

  <div class="absolute left-1/2 top-0 z-20 -translate-x-1/2 -translate-y-1/2" aria-hidden="true">
    <div
      class="relative grid h-33 w-33 place-items-center rounded-full border border-ink/10 bg-ivory shadow-[0_16px_32px_rgba(43,32,23,0.14)] md:h-52 md:w-52"
      data-medallion-disk
    >
      <svg
        viewBox="0 0 100 100"
        class="absolute inset-0 h-full w-full"
        data-medallion-ring
      >
        <defs>
          <path
            id="medallion-path"
            d="M 50,50 m -38,0 a 38,38 0 1,1 76,0 a 38,38 0 1,1 -76,0"
            fill="none"
          ></path>
        </defs>
        <text
          class="fill-bronze text-[7.5px] md:text-[9px]"
          style={{ letterSpacing: '0.22em' }}
        >
          <textPath href="#medallion-path" startOffset="0%">
            {ringText}
          </textPath>
        </text>
      </svg>
      <span class="h-2 w-2 rotate-45 bg-bronze md:h-3 md:w-3"></span>
    </div>
  </div>
</section>

<style>
  .js [data-medallion-disk] {
    will-change: transform;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const ring = document.querySelector<HTMLElement>('[data-medallion-ring]');
    if (ring) {
      gsap.to(ring, {
        rotation: 360,
        duration: 22,
        ease: 'none',
        repeat: -1,
        transformOrigin: '50% 50%',
      });
    }

    gsap.fromTo(
      '[data-medallion-disk]',
      { y: -48 },
      {
        y: 52,
        ease: 'none',
        scrollTrigger: {
          trigger: '[data-image-section]',
          start: 'top bottom',
          end: 'bottom top',
          scrub: 1,
        },
      },
    );

    gsap.fromTo(
      '[data-caption]',
      { y: 18, autoAlpha: 0 },
      {
        y: 0,
        autoAlpha: 1,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '[data-image-section]',
          start: 'top 72%',
          toggleActions: 'play none none reverse',
        },
      },
    );
  });
</script>