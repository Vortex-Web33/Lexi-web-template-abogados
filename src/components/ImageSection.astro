---
import type { Translation } from '../i18n';
import { Icon } from 'astro-icon/components';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
---

<section class="relative" data-image-section>
  <div class="absolute left-1/2 top-0 z-20 -translate-x-1/2 -translate-y-1/2" aria-hidden="true">
    <div
      class="relative grid h-28 w-28 place-items-center rounded-full bg-ink md:h-36 md:w-36"
      data-scroll-badge
    >
      <span
        class="pointer-events-none absolute inset-0 rounded-full border-[1.5px] border-bronze"
        aria-hidden="true"></span>
      <svg viewBox="0 0 100 100" class="absolute inset-0 h-full w-full" data-scroll-ring>
        <defs>
          <path
            id="scroll-path"
            d="M 50,50 m -40,0 a 40,40 0 1,1 80,0 a 40,40 0 1,1 -80,0"
            fill="none"></path>
        </defs>
        <text class="fill-ivory text-[7.5px] md:text-[9px]" style={{ letterSpacing: '0.16em' }}>
          <textPath href="#scroll-path" startOffset="0%">
            Scroll Down · Scroll Down · Scroll Down ·
          </textPath>
        </text>
      </svg>
      <span
        class="absolute left-1/2 top-1/2 h-[78%] w-[78%] -translate-x-1/2 -translate-y-1/2 rounded-full border border-bronze/60"
      ></span>
      <div
        class="absolute left-1/2 top-1/2 grid h-[72%] w-[72%] -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-ivory"
        data-scroll-arrow
      >
        <Icon name="lucide:arrow-down" class="h-10 w-10 text-ink md:h-10 md:w-10" />
      </div>
    </div>
  </div>

  <div
    class="relative w-full overflow-hidden"
    data-parallax
    style="mask-image: radial-gradient(circle 64px at 50% 0%, transparent 62px, black 64px); -webkit-mask-image: radial-gradient(circle 64px at 50% 0%, transparent 62px, black 64px);"
  >
    <img
      src="/images/office.jpg"
      alt={t.imageSection.caption}
      width="2000"
      height="1335"
      class="h-[50svh] w-full object-cover object-[center_35%] brightness-[0.92] contrast-[1.05] saturate-[0.85] sepia-[0.18] will-change-transform sm:h-[60svh] md:h-[72svh]"
      loading="lazy"
      decoding="async"
      data-parallax-target
    />
  </div>

  <div class="absolute bottom-5 left-4 md:bottom-9 md:left-10" data-caption>
    <div class="flex max-w-[34ch] items-start gap-3 md:max-w-[44ch]">
      <span aria-hidden="true" class="mt-1.5 h-px w-9 shrink-0 bg-ivory/70 md:w-12"></span>
      <p class="text-[13px] font-light leading-relaxed tracking-wide text-ivory/90 md:text-[15px]">
        {t.imageSection.caption}
      </p>
    </div>
  </div>
</section>

<style>
  .js [data-scroll-badge] {
    will-change: transform;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const badge = document.querySelector<HTMLElement>('[data-scroll-badge]');
    const ring = document.querySelector<HTMLElement>('[data-scroll-ring]');
    const arrow = document.querySelector<HTMLElement>('[data-scroll-arrow]');

    if (badge) {
      gsap.fromTo(
        badge,
        { scale: 0.85, autoAlpha: 0 },
        {
          scale: 1,
          autoAlpha: 1,
          duration: 1,
          ease: 'power3.out',
          immediateRender: true,
          scrollTrigger: {
            trigger: '[data-image-section]',
            start: 'top 82%',
            toggleActions: 'play none none reverse',
          },
        },
      );

      badge.addEventListener('mouseenter', () => {
        gsap.to(badge, { scale: 1.08, duration: 0.4, ease: 'power3.out', overwrite: 'auto' });
      });
      badge.addEventListener('mouseleave', () => {
        gsap.to(badge, { scale: 1, duration: 0.5, ease: 'power2.out', overwrite: 'auto' });
      });
    }

    if (ring) {
      gsap.to(ring, {
        rotation: 360,
        duration: 22,
        ease: 'none',
        repeat: -1,
        transformOrigin: '50% 50%',
      });
    }

    if (arrow) {
      gsap.to(arrow, {
        y: 4,
        duration: 1.5,
        ease: 'sine.inOut',
        yoyo: true,
        repeat: -1,
      });
    }

    gsap.fromTo(
      '[data-caption]',
      { y: 18, autoAlpha: 0 },
      {
        y: 0,
        autoAlpha: 1,
        duration: 0.9,
        ease: 'power3.out',
        immediateRender: true,
        scrollTrigger: {
          trigger: '[data-image-section]',
          start: 'top 72%',
          toggleActions: 'play none none reverse',
        },
      },
    );
  });
</script>
