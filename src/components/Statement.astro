---
import type { Translation } from '../i18n';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
---

<section class="px-8 py-20 text-center md:px-20 md:py-28" data-reveal-clip>
  <p
    class="mx-auto max-w-[70%] text-balance text-xl font-medium leading-[1.4] text-taupe md:text-[1.9rem] md:leading-[1.38]"
  >
    {
      t.statement.segments.map((s) =>
        s.strong ? (
          <strong class="font-serif font-semibold italic text-ink">{s.t}</strong>
        ) : (
          <span>{s.t}</span>
        ),
      )
    }
  </p>
</section>
