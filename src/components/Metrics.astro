---
import type { Translation } from '../i18n';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
---

<section class="relative px-6 pb-20 md:px-16 md:pb-24">
  <div class="grid grid-cols-2 md:grid-cols-4" data-reveal-group>
    {
      t.metrics.map((m, i) => (
        <div
          class={`px-4 py-8 text-center md:px-8 md:py-10 ${
            i % 2 === 1 ? 'border-l border-line' : ''
          } ${i >= 2 ? 'border-t border-line md:border-t-0' : ''} ${i >= 2 ? 'md:border-l' : ''}`}
        >
          <p class="text-4xl font-bold tabular-nums tracking-tight text-ink md:text-5xl">{m.value}</p>
          <p class="mt-3 text-[10px] uppercase tracking-luxe text-taupe">{m.label}</p>
        </div>
      ))
    }
  </div>

  <div class="pointer-events-none absolute -bottom-12 left-1/2 z-20 -translate-x-1/2" data-reveal>
    <svg
      viewBox="0 0 120 120"
      class="h-24 w-24 motion-safe:animate-[spin_18s_linear_infinite] md:h-28 md:w-28"
      role="img"
      aria-label={t.nav.contact}
    >
      <circle cx="60" cy="60" r="58" fill="var(--color-mocha)" />
      <circle cx="60" cy="60" r="54" fill="none" stroke="var(--color-ivory)" stroke-opacity="0.35" stroke-width="1.5" />
      <defs>
        <path id="badge-circle" d="M 60,60 m -44,0 a 44,44 0 1,1 88,0 a 44,44 0 1,1 -88,0" fill="none" />
      </defs>
      <text class="fill-ivory" style="font-size: 8.5px; letter-spacing: 0.2em; font-family: 'Inter Variable', sans-serif;">
        <textPath href="#badge-circle">{t.scrollBadge}</textPath>
      </text>
      <g stroke="var(--color-ivory)" stroke-width="2.5" stroke-linecap="round" fill="none">
        <path d="M60 42v34" />
        <path d="M52 68l8 8 8-8" />
      </g>
    </svg>
  </div>
</section>