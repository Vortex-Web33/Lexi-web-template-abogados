---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { locales, type Locale, type Translation } from '../i18n';

interface Props {
  locale: Locale;
  t: Translation;
  rest: string;
}

const { locale, t, rest } = Astro.props;

const navItems = [
  { label: t.nav.home, path: '' },
  { label: t.nav.about, path: 'about' },
  { label: t.nav.caseStudy, path: 'case-study' },
  { label: t.nav.services, path: 'services' },
];

const linkTo = (path: string) => getRelativeLocaleUrl(locale, path);
const isActive = (path: string) => rest === path;
---

<header class="relative z-40 border-b border-line bg-ivory">
  <div class="relative flex h-14 items-center justify-between px-5 md:h-16 md:px-10">
    <a href={linkTo('')} class="flex items-baseline gap-0.5" aria-label="LexCore">
      <span class="font-serif text-[22px] font-semibold tracking-tight text-ink">LexCore</span>
      <span class="text-lg font-bold text-bronze">.</span>
    </a>

    <nav aria-label="Main" class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-6 md:flex">
      {
        navItems.map((item) => (
          <a
            href={linkTo(item.path)}
            class={`text-xs font-medium uppercase text-luxe-sm transition-colors hover:text-ink ${
              isActive(item.path) ? 'text-ink' : 'text-cocoa'
            }`}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-5">
      <div class="hidden items-center gap-2.5 text-xs font-medium uppercase text-luxe-sm lg:flex">
        {
          locales.map((l) => (
            <a
              href={getRelativeLocaleUrl(l, rest)}
              class={l === locale ? 'text-ink' : 'text-cocoa transition-colors hover:text-ink'}
            >
              {l}
            </a>
          ))
        }
      </div>
      <a
        href={linkTo('contact')}
        class="rounded-full bg-mocha px-5 py-2.5 text-xs font-medium uppercase text-luxe-sm text-ivory transition-all hover:scale-[1.03] hover:bg-cocoa"
      >
        {t.nav.cta}
      </a>
    </div>
  </div>

  <nav aria-label="Main mobile" class="flex gap-6 overflow-x-auto px-5 py-3 md:hidden">
    {
      navItems.map((item) => (
        <a
          href={linkTo(item.path)}
          class={`whitespace-nowrap text-xs font-medium uppercase text-luxe-sm ${
            isActive(item.path) ? 'text-ink' : 'text-cocoa'
          }`}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>