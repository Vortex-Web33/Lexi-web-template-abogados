---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Icon } from 'astro-icon/components';
import { locales } from '../../i18n';
import type { Locale } from '../../i18n';
import { getTranslation } from '../../i18n';
import Base from '../../layouts/Base.astro';
import CountUp from '../../components/CountUp.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.currentLocale as Locale;
const t = getTranslation(locale);
const contact = getRelativeLocaleUrl(locale, 'contact');
const notes = t.about.marginNotes;

const stats = t.about.stats.map((s) => {
  const parts = s.value.match(/^([\d.,]+)(.*)$/);
  const raw = parts?.[1] ?? s.value;
  const digits = raw.replace(/[^\d]/g, '');
  const isK = /K/i.test(raw);
  return {
    label: s.label,
    value: parseInt(digits, 10) || 0,
    unit: isK ? 'K' : '',
    suffix: parts?.[2] ?? '',
  };
});
---

<Base locale={locale} title={`${t.about.title} — LexCore`} description={t.meta.description}>
  <!-- MEMBRETE -->
  <section class="relative overflow-hidden" data-reveal>
    <!--
    THESIS: the about page is a letter from the firm to the client — the one-document form that makes partner-led, discreet, precise legible at once; it refuses the team/cards grid and the hero-metric template.
    OWN-WORLD: ivory paper, double hairlines and bronze diamonds (letterhead rules), Cormorant italic salutation and signature, Inter body at reading measure with margin notes, watermark LEXCORE in the paper, Lady Justice as a near-invisible watermark behind the postscript, tabular Cormorant numerals counted up in the enclosure.
    STORY: the visitor reads the firm's own letter — origins, method, clients — trusts the postscript of commitments and the enclosed figures, and signs off by booking the free consultation.
    FIRST VIEWPORT: centered letterhead (double rule · LexCore. · Madrid & Miami · double rule) over the watermark; below, the letter column: serif subject title, italic salutation, drop-cap intro at reading size.
    FORM: Firm Correspondence / Letterhead — dealt structure 6 of 7 on the surface roll, seed key 090bb0d8; user locked card "Carta de los Socios".
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance.
    -->
    <span
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 block select-none whitespace-nowrap text-center font-serif text-[max(8rem,18vw)] font-bold uppercase leading-none text-watermark mask-[linear-gradient(to_bottom,black_35%,transparent_100%)]"
    >
      LEXCORE
    </span>
    <div class="relative mx-auto max-w-5xl px-6 pb-12 pt-24 text-center md:px-10 md:pb-16 md:pt-32">
      <div class="mx-auto flex max-w-2xl items-center gap-3 md:gap-4" aria-hidden="true">
        <span class="h-px flex-1 bg-ink/25"></span>
        <span class="h-1.5 w-1.5 rotate-45 bg-bronze"></span>
        <span class="h-px flex-1 bg-ink/25"></span>
      </div>
      <p class="mt-7 font-serif text-5xl font-semibold tracking-tight text-ink md:text-6xl">
        LexCore<span class="text-bronze">.</span>
      </p>
      <p class="mt-4 text-[10px] font-medium uppercase tracking-luxe text-stone md:text-[11px]">
        {t.about.officeLine}
      </p>
      <div
        class="mx-auto mt-7 flex max-w-2xl items-center gap-3 md:mt-8 md:gap-4"
        aria-hidden="true"
      >
        <span class="h-px flex-1 bg-ink/25"></span>
        <span class="h-1.5 w-1.5 rotate-45 bg-bronze"></span>
        <span class="h-px flex-1 bg-ink/25"></span>
      </div>
    </div>
  </section>

  <!-- CARTA -->
  <section class="mx-auto max-w-3xl px-6 md:px-10" data-reveal>
    <h1
      class="text-balance font-serif text-3xl font-semibold leading-tight tracking-tight text-ink md:text-[2.6rem]"
    >
      {t.about.title}
    </h1>
    <p class="mt-10 font-serif text-2xl font-medium italic text-cocoa md:text-[1.75rem]">
      {t.about.salutation}
    </p>
    <p
      class="mt-6 text-[15px] leading-[1.8] text-taupe first-letter:float-left first-letter:mr-2.5 first-letter:font-serif first-letter:text-[3.2rem] first-letter:font-semibold first-letter:leading-[0.82] first-letter:text-ink md:text-base"
    >
      {t.about.intro}
    </p>
  </section>

  <!-- CUERPO DE LA CARTA -->
  <section class="mx-auto mt-14 max-w-3xl space-y-12 px-6 md:mt-20 md:space-y-14 md:px-10">
    {
      t.about.paragraphs.map((p, i) => (
        <div class="md:grid md:grid-cols-[9.5rem_1fr] md:gap-10" data-reveal>
          <p class="mb-2.5 text-[10px] font-medium uppercase tracking-luxe text-stone md:mb-0 md:pt-1.5">
            {notes[i]}
          </p>
          <p class="text-[15px] leading-[1.8] text-taupe md:text-base">{p}</p>
        </div>
      ))
    }
  </section>

  <!-- POSDATA -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0" aria-hidden="true">
      <img
        src="/images/dama-justicia.jpg"
        alt=""
        width="1066"
        height="1600"
        class="h-full w-full object-cover object-[center_35%] opacity-[0.07] saturate-[0.85] sepia-[0.2]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="relative mx-auto max-w-5xl px-6 py-20 md:px-10 md:py-28">
      <h2
        class="text-balance font-serif text-2xl font-semibold italic text-ink md:text-[2rem]"
        data-reveal
      >
        {t.about.psTitle}
      </h2>
      <div class="mt-4 grid md:grid-cols-2 md:gap-x-10" data-reveal-group>
        {
          t.about.values.map((v, i) => (
            <div
              class={`border-t border-line py-8 md:py-10 ${i % 2 === 1 ? 'md:border-l md:pl-10' : 'md:pr-10'}`}
            >
              <h3 class="flex items-center gap-3 font-serif text-2xl font-semibold italic text-ink">
                <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rotate-45 bg-bronze" />
                {v.title}
              </h3>
              <p class="mt-3 pl-5 text-sm leading-relaxed text-taupe md:text-[15px]">{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ANEXO -->
  <section class="mx-auto mt-20 max-w-3xl px-6 md:mt-28 md:px-10">
    <h2
      class="text-balance font-serif text-2xl font-semibold italic text-ink md:text-[2rem]"
      data-reveal
    >
      {t.about.annexTitle}
    </h2>
    <div class="mt-4" data-reveal-group>
      {
        stats.map((s) => (
          <CountUp
            value={s.value}
            suffix={s.suffix}
            unit={s.unit}
            label={s.label}
            locale={t.htmlLang}
          />
        ))
      }
      <div class="border-t border-line" aria-hidden="true"></div>
    </div>
  </section>

  <!-- CIERRE -->
  <section
    class="mx-auto max-w-3xl px-6 pb-10 pt-20 text-center md:px-10 md:pb-16 md:pt-28"
    data-signature
  >
    <p class="font-serif text-xl font-medium italic text-taupe md:text-2xl" data-reveal>
      {t.about.closing}
    </p>
    <p
      class="mt-6 font-serif text-6xl font-semibold italic leading-none tracking-tight text-ink md:text-7xl"
      data-reveal
    >
      LexCore<span class="text-bronze">.</span>
    </p>
    <svg viewBox="0 0 340 44" class="mx-auto mt-5 h-11 w-72 text-bronze md:w-80" aria-hidden="true">
      <path
        d="M8 32 C 60 6, 118 36, 168 18 S 250 14, 332 26"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        data-signature-stroke></path>
    </svg>
    <p class="mx-auto mt-8 max-w-sm text-xs leading-relaxed text-taupe" data-reveal>
      {t.contact.form.note}
    </p>
    <div data-reveal>
      <a
        href={contact}
        class="mt-10 inline-flex items-center gap-2 rounded-full bg-mocha px-7 py-4 text-xs font-medium uppercase tracking-luxe text-ivory transition-all hover:scale-[1.03] hover:bg-cocoa"
      >
        {t.hero.cta}
        <Icon name="lucide:arrow-up-right" class="h-3 w-3" />
      </a>
    </div>
  </section>
</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const path = document.querySelector<SVGPathElement>('[data-signature-stroke]');
    if (!path) return;

    const len = path.getTotalLength();
    path.style.strokeDasharray = String(len);
    path.style.strokeDashoffset = String(len);

    gsap.fromTo(
      path,
      { strokeDashoffset: len },
      {
        strokeDashoffset: 0,
        duration: 1.8,
        ease: 'power2.inOut',
        scrollTrigger: {
          trigger: '[data-signature]',
          start: 'top 72%',
          once: true,
        },
      },
    );
  });
</script>
