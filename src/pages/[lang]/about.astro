---
import { locales } from '../../i18n';
import type { Locale } from '../../i18n';
import { getTranslation } from '../../i18n';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.currentLocale as Locale;
const t = getTranslation(locale);
---

<Base locale={locale} title={`${t.about.title} — LexCore`} description={t.meta.description}>
  <section class="px-6 pb-14 pt-16 text-center md:px-14 md:pt-24" data-reveal>
    <h1 class="text-balance text-4xl font-bold uppercase tracking-tight text-ink md:text-6xl">{t.about.title}</h1>
    <p class="mx-auto mt-6 max-w-xl text-balance text-sm leading-relaxed text-taupe md:text-base">{t.about.intro}</p>
  </section>

  <section class="mx-auto max-w-2xl space-y-6 px-6 pb-16 text-[15px] leading-relaxed text-taupe md:px-10 md:text-base" data-reveal>
    {
      t.about.paragraphs.map((p) => (
        <p>{p}</p>
      ))
    }
  </section>

  <section class="relative overflow-hidden" data-reveal>
    <img
      src="/images/dama-justicia.jpg"
      alt="Lady Justice"
      class="h-[340px] w-full object-cover object-top md:h-[460px]"
      loading="lazy"
      decoding="async"
    />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/40 via-transparent to-transparent" aria-hidden="true" />
  </section>

  <section class="border-t border-line">
    <div class="grid md:grid-cols-2" data-reveal-group>
      {
        t.about.values.map((v, i) => (
          <div class={`px-8 py-10 md:px-12 ${i % 2 === 1 ? 'md:border-l md:border-line' : ''} ${i >= 2 ? 'border-t border-line' : ''}`}>
            <h2 class="font-serif text-2xl font-semibold italic text-ink">{v.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-taupe">{v.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-t border-line px-6 py-12 md:px-16">
    <div class="grid grid-cols-2 md:grid-cols-4" data-reveal-group>
      {
        t.about.stats.map((s, i) => (
          <div class={`px-4 py-6 text-center ${i % 2 === 1 ? 'border-l border-line' : ''} ${i >= 2 ? 'border-t border-line md:border-t-0' : ''} ${i >= 2 ? 'md:border-l' : ''}`}>
            <p class="text-3xl font-bold tabular-nums text-ink md:text-4xl">{s.value}</p>
            <p class="mt-2 text-[10px] uppercase tracking-luxe text-taupe">{s.label}</p>
          </div>
        ))
      }
    </div>
  </section>
</Base>