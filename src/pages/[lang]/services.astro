---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { locales } from '../../i18n';
import type { Locale } from '../../i18n';
import { getTranslation } from '../../i18n';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.currentLocale as Locale;
const t = getTranslation(locale);
---

<Base locale={locale} title={`${t.services.title} — LexCore`} description={t.meta.description}>
  <section class="px-6 pb-12 pt-16 text-center md:px-14 md:pt-24" data-reveal>
    <h1 class="text-balance text-4xl font-bold uppercase tracking-tight text-ink md:text-6xl">
      {t.services.title}
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-balance text-sm leading-relaxed text-taupe md:text-base">
      {t.services.intro}
    </p>
  </section>

  <section class="mx-auto max-w-4xl px-6 md:px-10" data-reveal-group>
    {
      t.services.items.map((item) => (
        <article class="flex flex-col gap-3 border-t border-line py-9 last:border-b md:flex-row md:items-start md:gap-10">
          <span class="font-serif text-2xl font-medium italic text-bronze md:w-16 md:text-3xl">
            {item.index}
          </span>
          <div>
            <h2 class="font-serif text-2xl font-semibold text-ink md:text-[1.7rem]">
              {item.title}
            </h2>
            <p class="mt-2.5 max-w-xl text-sm leading-relaxed text-taupe">{item.text}</p>
          </div>
        </article>
      ))
    }
  </section>

  <div class="px-6 pb-20 pt-12 text-center" data-reveal>
    <a
      href={getRelativeLocaleUrl(locale, 'contact')}
      class="inline-flex items-center gap-2 rounded-full bg-mocha px-6 py-3.5 text-xs font-medium uppercase text-luxe-sm text-ivory transition-all hover:scale-[1.03] hover:bg-cocoa"
    >
      {t.services.cta}
    </a>
  </div>
</Base>
