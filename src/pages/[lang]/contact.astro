---
import { locales } from '../../i18n';
import type { Locale } from '../../i18n';
import { getTranslation } from '../../i18n';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.currentLocale as Locale;
const t = getTranslation(locale);
---

<Base locale={locale} title={`${t.contact.title} — LexCore`} description={t.meta.description}>
  <section class="px-6 pb-14 pt-16 text-center md:px-14 md:pt-24" data-reveal>
    <h1 class="text-balance text-4xl font-bold uppercase tracking-tight text-ink md:text-6xl">{t.contact.title}</h1>
    <p class="mx-auto mt-6 max-w-xl text-balance text-sm leading-relaxed text-taupe md:text-base">{t.contact.intro}</p>
  </section>

  <section class="grid gap-14 border-t border-line px-6 py-14 md:grid-cols-[1.2fr_1fr] md:gap-20 md:px-14 md:py-16" data-reveal-group>
    <form class="space-y-8" action="#" method="post">
      <div>
        <label for="name" class="text-[10px] uppercase tracking-luxe text-bronze">{t.contact.form.name}</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          class="mt-2 w-full border-b border-line bg-transparent py-2.5 text-sm text-ink outline-none transition-colors placeholder:text-stone focus:border-mocha"
          placeholder="—"
        />
      </div>
      <div>
        <label for="email" class="text-[10px] uppercase tracking-luxe text-bronze">{t.contact.form.email}</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          class="mt-2 w-full border-b border-line bg-transparent py-2.5 text-sm text-ink outline-none transition-colors placeholder:text-stone focus:border-mocha"
          placeholder="—"
        />
      </div>
      <div>
        <label for="message" class="text-[10px] uppercase tracking-luxe text-bronze">{t.contact.form.message}</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="mt-2 w-full resize-none border-b border-line bg-transparent py-2.5 text-sm leading-relaxed text-ink outline-none transition-colors placeholder:text-stone focus:border-mocha"
          placeholder="—"
        ></textarea>
      </div>
      <div class="flex flex-col items-start gap-3">
        <button
          type="submit"
          class="inline-flex items-center gap-2 rounded-full bg-mocha px-6 py-3.5 text-xs font-medium uppercase text-luxe-sm text-ivory transition-all hover:scale-[1.03] hover:bg-cocoa"
        >
          {t.contact.form.submit}
        </button>
        <p class="text-[10px] uppercase tracking-luxe text-stone">{t.contact.form.note}</p>
      </div>
    </form>

    <aside class="space-y-10">
      {
        t.contact.offices.map((o) => (
          <div>
            <h2 class="font-serif text-2xl font-semibold italic text-ink">{o.city}</h2>
            <p class="mt-3 text-sm leading-relaxed text-taupe">{o.address}</p>
            <p class="mt-1 text-sm text-taupe">{o.phone}</p>
            <p class="mt-1 text-sm text-mocha">{o.email}</p>
          </div>
        ))
      }
    </aside>
  </section>
</Base>